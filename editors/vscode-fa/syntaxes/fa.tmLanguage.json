          "match": "(?<![\\w.])\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?(?![\\w])"
        },
        {
          "name": "constant.numeric.float.fa",
          "match": "(?<![\\w.])\\d[\\d_]*[eE][+-]?\\d+(?![\\w])"
        },
        {
          "name": "constant.numeric.integer.fa",
          "match": "(?<![\\w.])\\d[\\d_]*(?![\\w.])"
