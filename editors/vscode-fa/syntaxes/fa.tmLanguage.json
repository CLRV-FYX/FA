    "calls": {
      "patterns": [
        {
          "match": "([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.fa"
            }
          }
        },
        {
          "match": "(?<=\\.)\\s*([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": {
