fn main() -> i64:
    let m = Map<str, i64>()
    m.set("one", 1)
    m.set("two", 2)
    m.set("three", 3)
    print(len(m))
    print(m.get("one"), m.get("three"))
    print(m.has("two"), m.has("four"))
    m.set("one", 111)
    print(m.get("one"))
    m.del("two")
    print(m.has("two"), len(m))
    for k in m:
        print(k)
    return 0
