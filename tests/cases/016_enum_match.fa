enum Color:
    Red
    Green
    Blue

fn name_of(c: Color) -> str:
    match c:
        Color.Red:
            return "红"
        Color.Green:
            return "绿"
        Color.Blue:
            return "蓝"
    return "?"

fn main() -> i64:
    let c = Color.Green
    print(name_of(c))
    match c:
        Color.Red:
            print("红色")
        Color.Green:
            print("绿色")
        Color.Blue:
            print("蓝色")
    let n = 2
    match n:
        1:
            print("一")
        2:
            print("二")
        _:
            print("其他")
    return 0
