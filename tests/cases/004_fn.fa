fn add(a: i64, b: i64) -> i64:
    return a + b

fn swap_sign(x: i64) -> i64:
    if x > 0:
        return -x
    return -x

fn many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64:
    return a + b + c + d + e + f + g + h

fn main() -> i64:
    print(add(3, 4))
    print(swap_sign(-9))
    print(many(1, 2, 3, 4, 5, 6, 7, 8))
    return 0
