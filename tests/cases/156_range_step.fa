# range() 的三种写法与步长：range(止) / range(起, 止) / range(起, 止, 步长)
#
# FA 一直有 `for i in 起..止` 和 `起..=止`，但**没有步长** —— 想跳着走只能
# 写 while，或者 `for i in 0..n { let j = i * 2 }` 绕一圈。这一例钉住补上的
# range()，以及它和老写法必须完全一致的几条规矩：
#
#   1. 步长可以是负的（倒着走），比较方向跟着步长的符号翻过来。
#      负数字面量在 AST 里是 Unary('-', NumLit) 而不是一个数字节点，
#      认出它才能让 `range(10, 0, -2)` 在编译期就定下方向，
#      不用在循环头每轮多判一次符号。
#   2. 步长不能是 0。**字面量 0 在编译期就报错**（这是个写死的死循环，
#      没有正当理由）；运行时才算出来的 0（比如从参数读来的步长）
#      在进循环之前 panic 一句人话，绝不给用户一个挂住的终端。
#   3. range 不是一等值 —— 和 `起..止` 同一条规矩：只能写在 for 的遍历位置，
#      不能存进变量、当参数传、也不能 print。
#   4. break / continue 在带步长的循环里照样对：continue 跳到「自增之前」，
#      自增用的是步长而不是 1。这一条最容易写错 —— 跳到循环头就等于永远不自增。
#   5. 遍历 Vec / str / Map / 数组的下标永远是一格格走，不受步长影响。

fn main() -> i64:
    # ---- 1. 三种写法 ----
    for i in range(4):
        write(i, " ")
    print("<- range(止)")

    for i in range(2, 6):
        write(i, " ")
    print("<- range(起, 止)")

    for i in range(0, 10, 3):
        write(i, " ")
    print("<- range(起, 止, 步长)")

    # ---- 2. 负步长：倒着走 ----
    for i in range(10, 0, -2):
        write(i, " ")
    print("<- 负步长")

    for i in range(5, 0, -1):
        write(i, " ")
    print("<- 倒数")

    # ---- 3. 步长比区间还大：只走一轮 ----
    for i in range(0, 3, 10):
        write(i, " ")
    print("<- 步长过大")

    # ---- 4. 空区间：一轮都不走 ----
    for i in range(5, 5):
        print("这行不该出现")
    for i in range(0, 10, -1):
        print("这行也不该出现（正着走的起点已经在终点之后）")
    print("空区间 0 轮")

    # ---- 5. 运行时才算出来的步长（方向得在循环头现判）----
    let k = 3
    for i in range(0, 12, k):
        write(i, " ")
    print("<- 运行时正步长")

    let d = 0 - 4
    for i in range(8, 0, d):
        write(i, " ")
    print("<- 运行时负步长")

    # ---- 6. break / continue 配步长 ----
    for i in range(0, 20, 4):
        if i == 8:
            continue
        if i == 16:
            break
        write(i, " ")
    print("<- continue 跳过 8，break 停在 16 之前")

    # ---- 7. 嵌套：外层带步长，内层老写法 ----
    for i in range(0, 6, 2):
        for j in 0..2:
            write(i * 10 + j, " ")
    print("<- 嵌套")

    # ---- 8. 老写法一个都不能坏 ----
    for i in 0..4:
        write(i, " ")
    print("<- 0..4")
    for i in 0..=3:
        write(i, " ")
    print("<- 0..=3")

    # ---- 9. 遍历容器仍是逐格走，不受步长机制影响 ----
    for x in Vec<i64>[5, 6, 7]:
        write(x, " ")
    print("<- Vec")
    for c in "abc":
        write(c, " ")
    print("<- str")

    # ---- 10. 循环变量照常能参与运算 ----
    let total = 0
    for i in range(1, 11, 2):
        total += i
    print("1+3+5+7+9 = ", total)

    return 0
