# expect-compile-error: 嵌套函数不能捕获外层局部变量 'base'
# 嵌套函数是**提升**成顶层函数实现的（符号名 fa_外层__内层），没有环境可捕获。
# 报错要说清是哪一层、哪个变量，而不是一句「未定义的标识符 'base'」——
# 检查内层函数体时故意挂一条没有父作用域的新链，未定义的名字再回去外层链里找，
# 找到了就是「想捕获」，给专门的诊断。
fn main() -> i64:
    let base = 10
    fn add_base(x: i64) -> i64:
        return x + base
    print(add_base(1))
    return 0
