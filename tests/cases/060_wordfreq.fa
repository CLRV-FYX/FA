# 综合集成用例：一个真实的「词频统计 + 排序 + 报表」程序。
# 一次性用上：结构体与方法、枚举带载荷、Map/Vec/字符串、下标、char 算术、
# 函数指针当参数、递归、if/match 表达式、单行块与花括号块、defer、指针、插值、
# 三引号多行字符串。这类「多个特性叠在一起」的程序抓到了三个各自独立的后端 bug：
#   1) 形参当下标（rows[i]）时，比例变址里的 Temp 没跟着 lower_params 换号
#   2) RET 的尾声按「此刻用到的被调用者保存寄存器」重算，push/pop 数量对不上
#   3) for x in <函数调用> 在循环体里把可迭代对象又求值了一遍（每轮新建 + 每轮释放）
# 单独测每个特性都过得去，叠在一起才会露出来 —— 所以这个用例值得留着。
# 综合集成用例：词频统计 + 自定义排序 + 报表
# 一次性用上：结构体与方法、枚举带载荷、Map/Vec、下标、字符串处理、
# 函数指针、递归、if/match 表达式、单行块与花括号块、defer、指针、插值。

struct Word:
    text: str
    count: i64

struct Report:
    title: str
    rows: Vec<str>
    total: i64

enum Maybe:
    Nothing
    Just(w: Word)

enum Cmp:
    Less
    Equal
    Greater

impl Word:
    fn label(self) -> str:
        return "{self.text}={self.count}"

    fn scaled(self, k: i64) -> Word:
        return Word { text: self.text, count: self.count * k }

    fn bump(self, k: i64):
        self.count += k

impl Report:
    fn add_row(self, line: str):
        self.rows.push(line)

    fn render(self) -> str:
        let out = "== {self.title}（{self.total} 词）=="
        for r in self.rows {
            out = out + "\n" + r
        }
        return out

# 比较函数用函数指针传，排序算法与比较逻辑解耦
fn cmp_count_desc(a: Word, b: Word) -> i64:
    if a.count > b.count { return -1 }
    if a.count < b.count { return 1 }
    return 0

fn cmp_text_asc(a: Word, b: Word) -> i64:
    let la = a.text.len()
    let lb = b.text.len()
    let i = 0
    while i < la and i < lb {
        if a.text[i] != b.text[i] {
            return if a.text[i] < b.text[i] { -1 } else { 1 }
        }
        i += 1
    }
    return if la < lb { -1 } else if la > lb { 1 } else { 0 }

fn sort_words(ws: Vec<Word>, cmp: fn(Word, Word) -> i64) -> Vec<Word>:
    # 插入排序：稳定、够用，而且能顺带测试聚合元素在 Vec 里的读写
    let out = Vec<Word>[]
    for w in ws {
        let i = 0
        let placed = false
        while i < out.len() {
            if cmp(w, out[i]) < 0 {
                break
            }
            i += 1
        }
        if i < out.len() {
            # 在 i 处插入：先把后面的往后挪
            let j = out.len()
            out.push(w)
            while j > i {
                out[j] = out[j - 1]
                j -= 1
            }
            out[i] = w
        } else {
            out.push(w)
        }
    }
    return out

fn tokenize(text: str) -> Vec<str>:
    let out = Vec<str>[]
    let cur = ""
    for i in 0..text.len() {
        let c = text[i]
        let is_sep = c == ' ' or c == '\n' or c == ',' or c == '.' or c == ';'
        if is_sep {
            if cur.len() > 0 { out.push(cur) }
            cur = ""
        } else {
            cur = cur + str(c)
        }
    }
    if cur.len() > 0 { out.push(cur) }
    return out

fn lower(s: str) -> str:
    let out = ""
    for i in 0..s.len() {
        let b = s[i]
        if b >= 'A' and b <= 'Z' {
            # char 参与算术按 C 的规则提升成整数（以前直接报「不支持 char 与 char」）
            out = out + str(chr(b - 'A' + 'a'))
        } else {
            out = out + str(b)
        }
    }
    return out

fn count_words(tokens: Vec<str>) -> Vec<Word>:
    let m = Map<str, i64>()
    for t in tokens {
        let k = t.lower()
        m[k] = if m.has(k) { m[k] + 1 } else { 1 }
    }
    let ws = Vec<Word>[]
    for k in m.keys() {
        ws.push(Word { text: k, count: m[k] })
    }
    return ws

fn find_word(ws: Vec<Word>, text: str) -> Maybe:
    for w in ws {
        if w.text == text { return Maybe.Just(w) }
    }
    return Maybe.Nothing

fn describe(m: Maybe) -> str:
    return match m {
        Maybe.Nothing: "没找到"
        Maybe.Just(w): "找到了 {w.label()}"
    }

# 递归：算报表行数（顺便测递归 + 聚合）
fn total_chars(rows: Vec<str>, i: i64) -> i64:
    if i >= rows.len() { return 0 }
    return rows[i].len() + total_chars(rows, i + 1)

fn build_report(ws: Vec<Word>, top: i64) -> Report:
    let r = Report { title: "词频", rows: Vec<str>[], total: 0 }
    let i = 0
    while i < ws.len() and i < top {
        r.add_row("#{i + 1} {ws[i].label()}")
        r.total += ws[i].count
        i += 1
    }
    return r

fn main() -> i64:
    let text = """The quick brown fox jumps over the lazy dog.
The dog barks; the fox runs. Quick fox, quick dog!"""

    defer print("--- 结束 ---")

    let tokens = tokenize(text)
    print("词元数 =", tokens.len())

    let ws = count_words(tokens)
    print("不同词 =", ws.len())

    let by_count = sort_words(ws, cmp_count_desc)
    let by_text = sort_words(ws, cmp_text_asc)

    print("按词频：")
    for i in 0..3 {
        print("  ", by_count[i].label())
    }
    print("按字典序：")
    for i in 0..3 {
        print("  ", by_text[i].label())
    }

    let rep = build_report(by_count, 5)
    print(rep.render())
    print("报表字符数 =", total_chars(rep.rows, 0))

    print(describe(find_word(by_text, "fox")))
    print(describe(find_word(by_text, "cat")))

    # 方法：修改自身、返回聚合、缩放
    let w = Word { text: "fox", count: 3 }
    w.bump(4)
    print(w.label(), w.scaled(2).label())

    # 指针：通过指针改结构体字段
    let p: *Word = &w
    p.count = 100
    print(w.count, p.text)

    # if / match 表达式
    let verdict = if w.count > 50 { "高频" } else if w.count > 10 { "中频" } else { "低频" }
    print(verdict)
    let bucket = match w.count {
        100: "正好一百"
        _: "其它"
    }
    print(bucket)

    return 0
