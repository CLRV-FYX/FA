# expect-compile-error: 范围运算符不能连用
# `0..10..2` 会被解析成 (0..10)..2。FA 的 range 只有「起..止」/「起..=止」，
# 没有步进写法 —— 以前 sema 照样给个 range 类型，一路走到 asmgen 的二元运算符表
# 才 KeyError: '..'，把 Python 的异常堆栈糊在用户脸上。
# 顺带也拦住浮点/字符串端点（`0.0..3.0` 会被悄悄截断成 0..3，更难查）。
fn main() -> i64:
    for i in 0..10..2 {
        print(i)
    }
    return 0
