# 「可选值」：FA 没有 Option<T>，用带载荷的枚举自己搭一个。
#
# 相比返回 -1 这种哨兵值，枚举的好处是调用方必须 match 才能拿到里面的数，
# 「忘了处理没有的情况」会变成一个漏掉的分支，而不是一个悄悄传下去的 -1。
# 注意 Maybe.Just(v) 带载荷要写括号，Maybe.Nothing 不带载荷不用写。
enum Maybe:
    Nothing
    Just(v: i64)

# 找第一个偶数：找到给 Just(值)，没有给 Nothing
fn first_even(v: Vec<i64>) -> Maybe:
    for x in v:
        if x % 2 == 0:
            return Maybe.Just(x)
    return Maybe.Nothing

# unwrap_or：拿到值，Nothing 就用给的默认值
fn unwrap_or(m: Maybe, dflt: i64) -> i64:
    match m:
        Maybe.Just(v):
            return v
        Maybe.Nothing:
            return dflt
    return dflt

fn describe(m: Maybe) -> str:
    match m:
        Maybe.Just(v):
            return "找到了 {v}"
        Maybe.Nothing:
            return "什么都没有"
    return "?"

fn main() -> i64:
    let a = Vec<i64>[1, 3, 8, 5]
    let b = Vec<i64>[1, 3, 5]
    print(describe(first_even(a)))
    print(describe(first_even(b)))
    print("unwrap_or：", unwrap_or(first_even(a), -1), unwrap_or(first_even(b), -1))

    # 空表也是 Nothing，不是崩溃
    print(describe(first_even(Vec<i64>[])))
    return 0
